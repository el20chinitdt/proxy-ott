{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/proxy?__vpath=/"
    },
    {
      "source": "/((?!api/proxy).*)",
      "destination": "/api/proxy?__vpath=/$1"
    }
  ]
}
